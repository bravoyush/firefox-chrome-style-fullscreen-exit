{
  "manifest_version": 3,
  "name": "Chromium Style Fullscreen Exit",
  "version": "1.2.1",
  "description": "Adds a customizable floating Chromium-style fullscreen exit button to Firefox.",

  "browser_specific_settings": {
    "gecko": {
      "id": "chromium-fullscreen-exit@utsav.addons",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },

  "permissions": [
    "storage"
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "web_accessible_resources": [
    {
      "resources": [
        "style.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },

  "action": {
    "default_title": "Fullscreen Exit Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },

  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}